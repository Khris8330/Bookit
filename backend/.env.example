# Server
PORT=3000

# Frontend origin allowed by CORS (no trailing slash).
# Local development uses http://localhost:5173 automatically.
# For production, set this to your deployed Vercel URL, e.g.:
# FRONTEND_URL=https://bookit.vercel.app
FRONTEND_URL=

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Organizer authentication (required)
# Generate password hash with: npm run hash-password
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string

# Optional JWT expiry (default 24h)
# JWT_EXPIRES_IN=24h
